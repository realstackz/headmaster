# ──────────────────────────────────────────────────────────────────────────────
# Headmaster — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit your actual .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Local example: postgres://postgres:postgres@localhost:5432/headmaster
# Supabase example: postgres://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/headmaster

# OpenAI API key (required)
# Used by the API server to call GPT-4o-mini for knowledge extraction.
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Session secret (required)
# Used to sign session cookies. Generate with: openssl rand -hex 32
# Must be at least 32 characters. Keep this private and stable across restarts.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# API server port (optional, default: 8080)
# Only change this if port 8080 conflicts with another service on your machine.
PORT=8080
